# AutoGrader Environment Configuration

# Core Storage & Runner
AUTOGRADER_DATABASE_URL=sqlite:///./data/autograder.db
AUTOGRADER_ARTIFACT_DIR=./data/artifacts
AUTOGRADER_RUNNER=bubblewrap
AUTOGRADER_DOCKER_IMAGE=autograder-sandbox:latest
AUTOGRADER_DOCKER_TIMEOUT_S=12
AUTOGRADER_BUBBLEWRAP_PATH=bwrap
AUTOGRADER_BUBBLEWRAP_UID=65534
AUTOGRADER_BUBBLEWRAP_GID=65534
AUTOGRADER_MAX_SOURCE_BYTES=200000
AUTOGRADER_MAX_BATCH_FILES=100
AUTOGRADER_MAX_TEST_INPUT_BYTES=100000
AUTOGRADER_MAX_OUTPUT_BYTES=100000
AUTOGRADER_FAKE_DELAY_MS=0

# LLM Integration Settings
AUTOGRADER_USE_LLM=true

# Primary Provider: Groq (Active)
# AUTOGRADER_LLM_PROVIDER=openai_compatible
AUTOGRADER_LLM_PROVIDER=ollama
AUTOGRADER_OPENAI_API_KEY=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
AUTOGRADER_OPENAI_BASE_URL=https://api.groq.com/openai/v1
AUTOGRADER_OPENAI_MODEL=qwen/qwen3.8-27b
AUTOGRADER_OPENAI_READ_TIMEOUT_S=30
AUTOGRADER_OPENAI_MAX_RETRIES=2

# Local Ollama Settings (Local runner & offline fallback - DO NOT REMOVE)
AUTOGRADER_OLLAMA_BASE_URL=http://127.0.0.1:11434
AUTOGRADER_OLLAMA_MODEL=llama3.1:latest
AUTOGRADER_OLLAMA_CONNECT_TIMEOUT_S=2
AUTOGRADER_OLLAMA_READ_TIMEOUT_S=45
AUTOGRADER_OLLAMA_MAX_RETRIES=1
AUTOGRADER_OLLAMA_MAX_CONCURRENCY=1
